+        payload_sha256: payloadDigest(item.input),
+        tool_use_sha256: sha256(Buffer.from(item.id, 'utf8')),
+        denied: index === 0,
+        policy_fields_missing: index === 0 ? ['source_types', 'limit'] : [],
