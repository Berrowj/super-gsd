+    ]);
+    for (let index = lineIndex; index >= 0; index -= 1) {
+      if (index < lineIndex && lines[index] === '});') return null;
+      if (starts.has(lines[index])) return starts.get(lines[index]);
+    }
+  }
+  return null;
