{
  "workflow": {
    "mode": "yolo",
    "granularity": "standard",
    "skip_discuss": false,
    "research": true,
    "plan_check": true,
    "verifier": true,
    "auto_advance": true,
    "nyquist_validation": true,
    "security_enforcement": true,
    "security_asvs_level": 1,
    "security_block_on": "high",
    "discuss_mode": "discuss",
    "research_before_questions": false,
    "plan_format": "compressed_xml",
    "agent_report_max_words": 300,
    "schema_v2_hash": "5867692da13edf8939bc4ab898768e9c5e9938716f4754d4583eaa2f7d0d5631",
    "plan_fix_retry_cap": 3
  },
  "safety": {
    "always_confirm_destructive": true,
    "always_confirm_external_services": true
  },
  "hooks": {
    "context_warnings": true
  },
  "parallelization": {
    "enabled": true,
    "plan_level": true,
    "task_level": false,
    "skip_checkpoints": true,
    "max_concurrent_agents": 3,
    "min_plans_for_parallel": 2
  },
  "model_routing": {
    "orchestrator": "opus",
    "researcher": "sonnet",
    "planner": "sonnet",
    "plan_checker": "sonnet",
    "executor": "sonnet",
    "verifier": "sonnet",
    "code_reviewer": "sonnet",
    "classifier": "haiku",
    "context_selector": "haiku"
  },
  "token_efficiency": {
    "state_read": "frontmatter_only",
    "context_injection": "brv_query",
    "checkpoint_threshold_percent": 70,
    "max_report_words": 300,
    "max_prompt_tokens": 1500,
    "log_usage": true
  },
  "byterover": {
    "enabled": false,
    "query_before_dispatch": true,
    "curate_after_dispatch": true,
    "script_registry": true,
    "max_queries_per_dispatch": 3,
    "max_context_tokens": 1000
  },
  "deliberation": {
    "enabled": true,
    "auto_gate": true,
    "gate_model": "haiku",
    "board": ["architect", "pragmatist", "contrarian", "moonshot"],
    "max_rounds": 2,
    "trigger_phases_affected": 3
  },
  "git": {
    "branching_strategy": "none",
    "commit_docs": true,
    "atomic_commits": true
  },
  "atc": {
    "enabled": true,
    "classify_model": "haiku",
    "skip_threshold_lines": 10,
    "lite_threshold_lines": 50,
    "lite_threshold_files": 3,
    "full_threshold_files": 4,
    "complexity_floor_files": 3,
    "complexity_floor_lines": 100
  },
  "browser_verify": {
    "enabled": true,
    "base_url": "http://localhost:3000",
    "routes": ["/"],
    "required_endpoints": [],
    "min_rows_per_route": 1,
    "load_timeout_ms": 15000,
    "approved_fallbacks": ["puppeteer"],
    "frontend_globs": [
      "**/*.html",
      "**/*.tsx",
      "**/*.jsx",
      "**/*.vue",
      "**/*.svelte",
      "**/*.astro",
      "**/*.css",
      "**/*.scss",
      "src/**/*.ts",
      "frontend/**",
      "web/**",
      "ui/**",
      "pages/**",
      "components/**"
    ],
    "fail_on_console_errors": true,
    "fail_on_network_errors": true,
    "block_on_failure_auto_mode": false,
    "deferral_ledger_auto_reopen_after_phases": 3
  },
  "overwatcher": {
    "auto_scan": true,
    "serve": false
  },
  "model_profile": "quality"
}
