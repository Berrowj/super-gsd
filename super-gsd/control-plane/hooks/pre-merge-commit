#!/usr/bin/env bash
# DLB-15: block merge commits ONLY in the deploy checkout; fast-forwards create no commit.
CLARITY_STATE_DIR=${CLARITY_CP_STATE_DIR:-"$HOME/.local/state/clarity-control-plane"}
CLARITY_DEPLOY_DEFAULT=/home/jackberrow/clarity-deploy

if [ -n "${CLARITY_CP_DEPLOY_CHECKOUT:-}" ]; then
  CLARITY_DEPLOY_CHECKOUT=$CLARITY_CP_DEPLOY_CHECKOUT
elif [ -r "$CLARITY_STATE_DIR/config.json" ]; then
  CLARITY_DEPLOY_CHECKOUT=$(python3 - "$CLARITY_STATE_DIR/config.json" "$CLARITY_DEPLOY_DEFAULT" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], "r", encoding="utf-8") as handle:
        value = json.load(handle).get("deploy_checkout", sys.argv[2])
    print(value if isinstance(value, str) and value else sys.argv[2])
except (OSError, ValueError, AttributeError):
    print(sys.argv[2])
PY
  )
else
  CLARITY_DEPLOY_CHECKOUT=$CLARITY_DEPLOY_DEFAULT
fi

TOP=$(git rev-parse --show-toplevel 2>/dev/null)
if [ "$TOP" = "$CLARITY_DEPLOY_CHECKOUT" ] && [ -z "${DEPLOY_OVERRIDE:-}" ]; then
  echo "──────────────────────────────────────────────────────────────"
  echo " BLOCKED by DLB-15: do not commit in ~/clarity-deploy (deploy checkout)."
  echo " Work in YOUR worktree; land via PR/merge; deploy via run-deploy.sh."
  echo " Incident hotfix: DEPLOY_OVERRIDE=incident git commit ..."
  echo "──────────────────────────────────────────────────────────────"
  exit 1
fi
exit 0
