{
  "schema_version": 2,
  "models": {
    "fable": { "provider": "anthropic", "model": "fable" },
    "astral": { "provider": "openai", "model": "astral" },
    "opus": { "provider": "anthropic", "model": "opus-4.7-xhigh" },
    "codex": { "provider": "openai", "model": "codex-gpt-5.5-xhigh" }
  },
  "model_routing": {
    "orchestrator": {
      "default": "fable",
      "allowed": ["fable", "opus", "codex", "astral"],
      "budget_per_unit": 1500,
      "notes": "Lean state machine. Read-dispatch-process-commit-loop. Never authors research, plans, code, or gates."
    },
    "deliberation": {
      "ceo": { "default": "opus", "allowed": ["fable", "opus", "codex", "astral"], "budget": 2000 },
      "board_members": { "default": "codex", "allowed": ["fable", "opus", "codex", "astral"], "budget_per_member": 2000, "max_round_2": 1500 }
    },
    "execution": {
      "researcher": { "default": "codex", "allowed": ["fable", "opus", "codex", "astral"], "budget": 3000 },
      "planner": { "default": "codex", "allowed": ["fable", "opus", "codex", "astral"], "budget": 2500 },
      "plan_checker": { "default": "codex", "allowed": ["fable", "opus", "codex", "astral"], "budget": 1500 },
      "executor": { "default": "codex", "allowed": ["fable", "opus", "codex", "astral"], "budget": 4000 },
      "verifier": { "default": "codex", "allowed": ["fable", "opus", "codex", "astral"], "budget": 3000 },
      "code_reviewer": { "default": "codex", "allowed": ["fable", "opus", "codex", "astral"], "budget": 2500 },
      "code_fixer": { "default": "codex", "allowed": ["fable", "opus", "codex", "astral"], "budget": 2000 }
    },
    "lightweight": {
      "classifier": { "default": "codex", "allowed": ["fable", "opus", "codex", "astral"], "budget": 200 },
      "context_selector": { "default": "codex", "allowed": ["fable", "opus", "codex", "astral"], "budget": 300 },
      "commit_writer": { "default": "codex", "allowed": ["fable", "opus", "codex", "astral"], "budget": 150 },
      "stuck_detector": { "default": "codex", "allowed": ["fable", "opus", "codex", "astral"], "budget": 200 },
      "decay_scorer": { "default": "codex", "allowed": ["fable", "opus", "codex", "astral"], "budget": 150 }
    }
  },
  "token_efficiency": {
    "sub_agent_report_max_words": 300,
    "plan_format": "compressed_xml",
    "state_read": "frontmatter_only",
    "context_injection": "sgsd_recall",
    "agent_rules_header_tokens": 80
  },
  "cost_ratios": {
    "opus": 1.0,
    "codex": 0.2
  }
}
