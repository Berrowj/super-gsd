{
  "_comment": "Merge into .planning/config.json to enable Super GSD features",
  "workflow": {
    "mode": "yolo",
    "granularity": "standard",
    "skip_discuss": false,
    "research": true,
    "plan_check": true,
    "verifier": true,
    "auto_advance": true,
    "plan_format": "compressed_xml",
    "agent_report_max_words": 300,
    "nyquist_validation": true
  },
  "browser_verify": {
    "enabled": false,
    "tool": "gsd-browser",
    "url_base": "http://localhost:5173",
    "timeout_sec": 60,
    "per_op_timeout_sec": 15,
    "capture_screenshots": true,
    "capture_har": true
  },
  "model_routing": {
    "schema_version": 2,
    "models": {
      "fable": {
        "provider": "anthropic",
        "model": "fable"
      },
      "astral": {
        "provider": "openai",
        "model": "gpt-6-astra",
        "reasoning_effort": "max"
      },
      "astra-max": {
        "provider": "openai",
        "model": "gpt-6-astra",
        "reasoning_effort": "max"
      },
      "luna-max": {
        "provider": "openai",
        "model": "gpt-5.6-luna",
        "reasoning_effort": "max"
      },
      "sol": {
        "provider": "openai",
        "model": "gpt-5.6-sol",
        "reasoning_effort": "xhigh"
      },
      "terra": {
        "provider": "openai",
        "model": "gpt-5.6-terra",
        "reasoning_effort": "xhigh"
      },
      "opus": {
        "provider": "anthropic",
        "model": "opus"
      },
      "sonnet": {
        "provider": "anthropic",
        "model": "sonnet"
      },
      "haiku": {
        "provider": "anthropic",
        "model": "haiku"
      },
      "codex": {
        "provider": "openai",
        "model": "gpt-5.6-sol",
        "reasoning_effort": "xhigh"
      }
    },
    "orchestrator": {
      "default": "fable",
      "allowed": [
        "fable",
        "astral",
        "astra-max",
        "luna-max",
        "sol",
        "terra",
        "opus",
        "sonnet",
        "haiku",
        "codex"
      ]
    },
    "researcher": {
      "default": "codex",
      "allowed": [
        "fable",
        "astral",
        "astra-max",
        "luna-max",
        "sol",
        "terra",
        "opus",
        "sonnet",
        "haiku",
        "codex"
      ]
    },
    "planner": {
      "default": "codex",
      "allowed": [
        "fable",
        "astral",
        "astra-max",
        "luna-max",
        "sol",
        "terra",
        "opus",
        "sonnet",
        "haiku",
        "codex"
      ]
    },
    "plan_checker": {
      "default": "codex",
      "allowed": [
        "fable",
        "astral",
        "astra-max",
        "luna-max",
        "sol",
        "terra",
        "opus",
        "sonnet",
        "haiku",
        "codex"
      ]
    },
    "executor": {
      "default": "codex",
      "allowed": [
        "fable",
        "astral",
        "astra-max",
        "luna-max",
        "sol",
        "terra",
        "opus",
        "sonnet",
        "haiku",
        "codex"
      ]
    },
    "verifier": {
      "default": "codex",
      "allowed": [
        "fable",
        "astral",
        "astra-max",
        "luna-max",
        "sol",
        "terra",
        "opus",
        "sonnet",
        "haiku",
        "codex"
      ]
    },
    "code_reviewer": {
      "default": "codex",
      "allowed": [
        "fable",
        "astral",
        "astra-max",
        "luna-max",
        "sol",
        "terra",
        "opus",
        "sonnet",
        "haiku",
        "codex"
      ]
    },
    "classifier": {
      "default": "codex",
      "allowed": [
        "fable",
        "astral",
        "astra-max",
        "luna-max",
        "sol",
        "terra",
        "opus",
        "sonnet",
        "haiku",
        "codex"
      ]
    },
    "context_selector": {
      "default": "codex",
      "allowed": [
        "fable",
        "astral",
        "astra-max",
        "luna-max",
        "sol",
        "terra",
        "opus",
        "sonnet",
        "haiku",
        "codex"
      ]
    }
  },
  "token_efficiency": {
    "state_read": "frontmatter_only",
    "context_injection": "sgsd_recall",
    "max_report_words": 300,
    "max_prompt_tokens": 1500,
    "log_usage": true
  },
  "memory": {
    "enabled": true,
    "query_before_dispatch": true,
    "curate_after_dispatch": true,
    "script_registry": true,
    "max_queries_per_dispatch": 3,
    "max_context_tokens": 1000,
    "root": ".planning/memory"
  },
  "deliberation": {
    "enabled": true,
    "auto_gate": true,
    "gate_model": "codex",
    "board": [
      "architect",
      "pragmatist",
      "contrarian",
      "moonshot"
    ],
    "max_rounds": 2,
    "trigger_phases_affected": 3
  },
  "git": {
    "branching_strategy": "none",
    "commit_docs": true,
    "atomic_commits": true
  },
  "atc": {
    "enabled": true,
    "classify_model": "codex",
    "skip_threshold_lines": 10,
    "lite_threshold_lines": 50,
    "lite_threshold_files": 3
  }
}
