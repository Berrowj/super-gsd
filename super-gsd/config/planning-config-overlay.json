{
  "_comment": "Merge into .planning/config.json to enable Super GSD features",
  "workflow": {
    "mode": "yolo",
    "granularity": "standard",
    "skip_discuss": false,
    "research": true,
    "plan_check": true,
    "verifier": true,
    "auto_advance": true,
    "plan_format": "compressed_xml",
    "agent_report_max_words": 300,
    "nyquist_validation": true
  },
  "browser_verify": {
    "enabled": false,
    "tool": "gsd-browser",
    "url_base": "http://localhost:5173",
    "timeout_sec": 60,
    "per_op_timeout_sec": 15,
    "capture_screenshots": true,
    "capture_har": true
  },
  "model_routing": {
    "orchestrator": "opus",
    "researcher": "codex",
    "planner": "codex",
    "plan_checker": "codex",
    "executor": "codex",
    "verifier": "codex",
    "code_reviewer": "codex",
    "classifier": "codex",
    "context_selector": "codex"
  },
  "token_efficiency": {
    "state_read": "frontmatter_only",
    "context_injection": "brv_query",
    "context_warning_percent": 70,
    "checkpoint_threshold_percent": 100000,
    "max_report_words": 300,
    "max_prompt_tokens": 1500,
    "log_usage": true
  },
  "byterover": {
    "enabled": true,
    "query_before_dispatch": true,
    "curate_after_dispatch": true,
    "script_registry": true,
    "max_queries_per_dispatch": 3,
    "max_context_tokens": 1000
  },
  "deliberation": {
    "enabled": true,
    "auto_gate": true,
    "gate_model": "codex",
    "board": ["architect", "pragmatist", "contrarian", "moonshot"],
    "max_rounds": 2,
    "trigger_phases_affected": 3
  },
  "git": {
    "branching_strategy": "none",
    "commit_docs": true,
    "atomic_commits": true
  },
  "atc": {
    "enabled": true,
    "classify_model": "codex",
    "skip_threshold_lines": 10,
    "lite_threshold_lines": 50,
    "lite_threshold_files": 3
  }
}
