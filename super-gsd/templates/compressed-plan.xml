<!-- Super GSD Compressed Plan Template
     Target: ~800 tokens (vs ~2,000 in GSD 1.0)
     Rule: Every token must justify itself. XML over prose. -->

<plan phase="{NN}" task="{PP}" model="{sonnet|haiku}" wave="{N}">
<goal>{One sentence: what this task delivers}</goal>
<files>{comma-separated list of files to create/modify}</files>
<deps>{comma-separated plan IDs this depends on, or "none"}</deps>
<steps>
  <!-- Each step: one atomic action. No explanation. Just instruction. -->
  <s>{Create FILE: export functionName(params). Logic: description.}</s>
  <s>{Modify FILE: add X to Y. Pattern: Z.}</s>
  <s>{Run: npm install package@version}</s>
</steps>
<verify>
  <!-- Each verify: command + expected result. Machine-checkable. -->
  <v cmd="{shell command}" expect="{exit 0|output contains X}"/>
  <v cmd="{grep -q 'pattern' file}" expect="exit 0"/>
</verify>
<context>
  <!-- Only include decisions/patterns directly relevant to THIS task -->
  <!-- Injected by orchestrator via sgsd-recall, not hardcoded -->
  <d>{Decision ID: one-liner}</d>
  <p>{Pattern: one-liner}</p>
  <e>{Error rule: one-liner}</e>
</context>
<rules>No intro. No summary. Code + verify only. Report format: FILES_CHANGED | VERIFICATION | DEVIATIONS | BLOCKERS | ONE_LINER. Max 300 words.</rules>
</plan>
