      "target_tool": "super-gsd/tools/plan-schema/validate.cjs",
      "inject_mechanism": "valid_schema_v2_plan_in_tmpdir",
      "expected_outcome": "PASS",
      "expected_reason_codes": [
        "scenario_pass"
      ],
      "soft_skip_when": null,
      "evidence_kind": "stdout_exit"
    },
    {
      "id": "deferred-debt-pass",
      "label": "Phase verifier returns PASS-WITH-DEFERRED-1 with one LOW debt entry",
      "kind": "happy",
      "target_tool": "super-gsd/scripts/lib/crit-backlog.cjs",
      "inject_mechanism": "synthetic_low_debt_entry",
      "expected_outcome": "PASS-WITH-DEFERRED-1",
      "expected_reason_codes": [
        "scenario_pass_with_deferred"
      ],
      "soft_skip_when": null,
      "evidence_kind": "stdout_exit"
    },
    {
