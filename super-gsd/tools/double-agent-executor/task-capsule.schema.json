{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://super-gsd.local/schemas/task-capsule-v1.json",
  "title": "SGSD Double-Agent Task Capsule",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "task_id", "goal", "role", "task_kind", "allowed_files", "risk"],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "milestone": { "type": ["string", "null"] },
    "phase": { "type": ["string", "number", "null"] },
    "plan": { "type": ["string", "null"] },
    "role": {
      "type": "string",
      "enum": ["researcher", "planner", "executor", "verifier", "reviewer", "orchestrator", "classifier", "other"]
    },
    "task_kind": {
      "type": "string",
      "enum": ["extraction", "inventory", "code_edit", "refactor", "test_repair", "schema_config", "docs", "review", "planning", "verification", "synthesis", "general"]
    },
    "goal": { "type": "string", "minLength": 1 },
    "allowed_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "forbidden_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "acceptance_commands": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "local_command": { "type": ["string", "null"] },
    "risk": { "type": "string", "enum": ["low", "medium", "high"] },
    "ambiguity": { "type": "string", "enum": ["low", "medium", "high"] },
    "requires_private_knowledge": { "type": "boolean" },
    "deterministic": { "type": "boolean" },
    "estimated_line_count": { "type": "number", "minimum": 0 },
    "max_input_tokens": { "type": "number", "minimum": 1 },
    "max_output_tokens": { "type": "number", "minimum": 1 },
    "operator_intent_summary": { "type": ["string", "null"] },
    "harness_change_id": {
      "type": ["string", "null"],
      "pattern": "^ch-[a-z0-9-]+$",
      "description": "Phase 100 cross-link to harness-change-manifest entry. Optional. When set, route-decisions evidence array adds a harness_change_manifest ref."
    },
    "context_packet": {
      "type": "object",
      "additionalProperties": true,
      "description": "Compiled-by-Claude private SGSD context attached to bounded Codex tasks. When private_context_compiled === true, Codex may execute the task without receiving broad roadmap/state context.",
      "properties": {
        "compiled_by": { "type": "string", "enum": ["claude", "operator", "local-script"] },
        "summary": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "private_context_compiled": { "type": "boolean" }
      }
    }
  }
}
