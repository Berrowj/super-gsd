{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://super-gsd.local/schemas/chronicle-manifest.schema.json",
  "title": "SGSD Chronicle Manifest",
  "description": "Manifest for chronicle files and their source evidence hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "generated_at",
    "chronicle_schema",
    "manifest_schema",
    "generator_versions",
    "chronicles",
    "source_cmb_ids",
    "source_test_runs",
    "source_commits",
    "source_file_paths"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "chronicle_schema": {
      "type": "string",
      "minLength": 1
    },
    "manifest_schema": {
      "type": "string",
      "minLength": 1
    },
    "generator_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "chronicles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/hashed_file"
      }
    },
    "source_cmb_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_test_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "result",
          "commit"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "$ref": "#/definitions/commit"
          }
        }
      }
    },
    "source_commits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/commit"
      }
    },
    "source_file_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/source_file"
      }
    }
  },
  "definitions": {
    "commit": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{7,40}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "errorMessage": "CHRONICLE-MANIFEST-01: manifest hashes must be lowercase sha256 hex strings"
    },
    "hashed_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "$ref": "#/definitions/hash"
        }
      }
    },
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hash"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "$ref": "#/definitions/hash"
        }
      },
      "errorMessage": {
        "required": {
          "hash": "CHRONICLE-MANIFEST-01: manifest source_file_paths require hashes"
        },
        "properties": {
          "hash": "CHRONICLE-MANIFEST-01: manifest source_file_paths require hashes"
        }
      }
    }
  }
}
